<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the Rest Assured Capstone Project.
  Created WITHOUT an archetype (as required by Assignment 1).

  Key points:
   - Java 11 or higher is required.
   - All framework + test code lives in src/test/java, so every dependency is test-scoped.
   - maven-surefire-plugin is told to execute testng.xml, which controls which
     test classes run and registers the Extent report listener.
   - The environment is chosen at run time:  mvn test -Denv=qa   (or -Denv=uat)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.perficient</groupId>
    <artifactId>restassured-capstone</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Rest Assured Capstone</name>
    <description>API automation framework for the GoRest application</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions are kept in one place so they are easy to upgrade -->
        <rest-assured.version>5.4.0</rest-assured.version>
        <testng.version>7.9.0</testng.version>
        <extentreports.version>5.1.1</extentreports.version>
        <jackson.version>2.17.0</jackson.version>
    </properties>

    <dependencies>
        <!-- Rest Assured: sends HTTP requests and validates responses -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG: test runner (annotations, priorities, dependencies, listeners) -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Jackson: converts POJOs to/from JSON (used by Rest Assured and our utilities) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Extent Reports: generates the HTML execution report -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
            </plugin>

            <!-- Surefire runs the tests when you execute "mvn test" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Use testng.xml as the single entry point of the suite.
                         Command line values such as -Denv=qa and -Dtoken=xxx are
                         automatically passed on to the test JVM by Surefire. -->
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
